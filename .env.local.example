# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# App
NEXT_PUBLIC_ROOT_DOMAIN=linkhub.api.br
NEXT_PUBLIC_APP_URL=https://linkhub.api.br

# Server-side encryption key for ERP credentials stored in tenants.erp_config
# Generate with: openssl rand -base64 32
ERP_CONFIG_ENCRYPTION_KEY=replace-with-32-byte-base64-secret

# IP de saída da aplicação — o endereço de onde partem as chamadas ao ERP do
# provedor. ERP brasileiro costuma trancar o webservice por IP, e é este que
# ele precisa liberar (não o IP para onde o domínio aponta: esse é o de
# entrada, e num deploy sem servidor os dois nem ficam na mesma máquina).
#
# Só preencha com um IP de saída que seja realmente fixo — IP fixo contratado,
# proxy próprio na frente das chamadas ou similar. Num deploy sem servidor o
# endereço muda sozinho e a liberação no ERP para de valer.
#
# Vazio: o painel avisa que ainda não há IP fixo em vez de exibir um errado.
# Aceita mais de um, separado por vírgula, e faixa em CIDR.
ERP_OUTBOUND_IP=

# Build do app Android dos provedores. O painel aciona o workflow
# .github/workflows/android-build.yml por aqui — sem o token, o botão
# "Gerar pacote Android" avisa que falta configurar.
# Token fine-grained com permissão "Actions: read and write" no repositório.
GITHUB_DISPATCH_TOKEN=
GITHUB_BUILD_REPO=gustavoviana/linkhub
GITHUB_BUILD_WORKFLOW=android-build.yml
GITHUB_BUILD_REF=main

# Exportação de screenshots para as lojas (tudo opcional).
# STORE_SHOT_SECRET assina o passe da rota de captura; sem ele usamos a
# service role key. CHROME_PATH só importa em dev (Windows/macOS), quando o
# Chrome não está num caminho conhecido. BROWSER_WS_ENDPOINT manda a captura
# para um serviço de navegador (Browserless e afins) em vez de subir o
# Chromium na própria função — a saída quando a função da Vercel não aguenta.
# STORE_SHOT_FONT_URL adiciona uma fonte ao Chromium serverless (emoji, por
# exemplo), que vem sem nenhuma instalada.
STORE_SHOT_SECRET=
CHROME_PATH=
BROWSER_WS_ENDPOINT=
STORE_SHOT_FONT_URL=

# Provisionamento automático de domínio na Vercel (opcional).
# Sem isso, cada subdomínio novo precisa ser adicionado à mão no painel.
# Token: vercel.com/account/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx

# DNS de linkhub.api.br (Cloudflare). Publica o TXT _vercel de cada subdomínio
# novo — sem ele a Vercel não emite o certificado e a central nasce fora do ar.
# Token com permissão Zone > DNS > Edit só nesse domínio. ZONE_ID é opcional.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Notificações push (avisos de fatura). Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@linkhub.api.br

# Segredo das rotas /api/cron/*. O mesmo valor vai no Vault do Supabase
# (linkhub_cron_secret), que o pg_cron usa para chamar /api/cron/push.
CRON_SECRET=
